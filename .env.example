# Copy to .env (repo root) and fill in. The backend reads this file on startup;
# the key is only used server-side and is never sent to the browser or the render sandbox.

# --- Required for live AI generation -----------------------------------------
ANTHROPIC_API_KEY=

# Only for user-scoped keys (sk-ant-usr-...) that aren't tied to a workspace:
# the workspace to bill (Console -> Settings -> Workspaces, looks like wrkspc_...).
ANTHROPIC_WORKSPACE_ID=

# --- Models (optional) --------------------------------------------------------
# One model for every call, or override per stage.
ANTHROPIC_MODEL=claude-opus-5-5
# PLANNER_MODEL=claude-opus-5-5
# CODEGEN_MODEL=claude-opus-5-5

# Effort per call: low | medium | high | xhigh | max (empty = model default).
PLANNER_EFFORT=medium
CODEGEN_EFFORT=medium
REPAIR_EFFORT=medium

# Server-side refusal fallback (re-runs a declined request on a fallback model).
ANTHROPIC_REFUSAL_FALLBACK=true

# --- Rendering (optional) -----------------------------------------------------
RENDERER_IMAGE=explainer-manim-renderer:0.19.2
RENDER_WIDTH=1920
RENDER_HEIGHT=1080
RENDER_FPS=30
RENDER_TIMEOUT_S=420
RENDER_CPUS=3
RENDER_MEMORY=3g
MAX_REPAIR_ATTEMPTS=2

# --- Lesson shape (optional) --------------------------------------------------
TARGET_DURATION_S=30
DURATION_TOLERANCE_S=3

# --- Server (optional) --------------------------------------------------------
# JOBS_DIR=backend/.jobs   (relative paths are resolved from the repo root)
JOB_TTL_HOURS=6
MAX_CONCURRENT_JOBS=2
ALLOW_OFFLINE_DEMO=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend (read by Next.js): where /api/* is proxied to.
BACKEND_URL=http://127.0.0.1:8000
